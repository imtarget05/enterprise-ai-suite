# ==============================================================
# ENTERPRISE AI SUITE — MONOREPO ENVIRONMENT TEMPLATE
# ==============================================================

# Global Profile: local | demo | full
PROFILE=demo
DEBUG=true

# Database (PostgreSQL 16)
DATABASE_URL=postgresql://postgres:enterprise_secure_pg_pass_2026@localhost:5432/enterprise_suite

# Shared ERPNext v15
ERPNEXT_URL=http://localhost:8080
ERPNEXT_API_KEY=demo_erp_api_key
ERPNEXT_API_SECRET=demo_erp_api_secret
ERPNEXT_USE_SANDBOX=true

# Salesforce Integration
SALESFORCE_AUTH_URL=https://login.salesforce.com/services/oauth2/token
SALESFORCE_INSTANCE_URL=https://enterprise-demo.my.salesforce.com
SALESFORCE_CLIENT_ID=demo_sf_client_id
SALESFORCE_CLIENT_SECRET=demo_sf_client_secret
SALESFORCE_USERNAME=developer@enterprise.demo
SALESFORCE_PASSWORD=demo_sf_password
SALESFORCE_USE_SANDBOX=true

# Project 1: Vector Search (Qdrant)
QDRANT_URL=https://cloud.qdrant.io:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=enterprise_knowledge

# Project 1: RabbitMQ Business Queue
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_ENABLED=false

# Project 2: Redpanda / Kafka Event Stream
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_ENABLED=false

# Project 2: Object Storage (Cloudflare R2 / MinIO)
STORAGE_PROVIDER=local
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=enterprise-qc-evidence

# Observability (Langfuse Cloud)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# LLM Cost Guardrails: MOCK | FREE_TIER | COMMERCIAL
LLM_PROVIDER=FREE_TIER
GEMINI_API_KEY=
OPENAI_API_KEY=
MAX_TOKENS_PER_REQ=1024
MONTHLY_BUDGET_USD=0.00
